<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Basic Music Player</title>
<style>
  body {
    margin: 0;
    font-family: system-ui, Arial, sans-serif;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
  .player {
    background: #0f0f1a;
    border-radius: 20px;
    padding: 30px;
    width: 380px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    text-align: center;
  }
  h1 { margin: 0 0 20px; font-size: 22px; }
  #song-title {
    font-size: 18px;
    margin: 15px 0;
    min-height: 27px;
    color: #aaa;
  }
  #progress-container {
    background: #333;
    height: 6px;
    border-radius: 3px;
    cursor: pointer;
    margin: 20px 0;
  }
  #progress {
    background: #6c5ce7;
    height: 100%;
    width: 0%;
    border-radius: 3px;
  }
  .controls {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin: 20px 0;
  }
  button {
    background: #6c5ce7;
    border: none;
    color: white;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    transition: 0.2s;
  }
  button:hover { transform: scale(1.1); }
  #play-btn { width: 60px; height: 60px; font-size: 22px; }
